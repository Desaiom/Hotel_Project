<% layout("/layouts/boilerplate") %>
<style>
  .show-img{
    height:550px;
    width:100%;
    object-fit:cover;
}

.carousel-caption{
    left:40px;
    right:auto;
    bottom:35px;
    text-shadow:0 3px 10px rgba(0,0,0,.7);
}

.carousel-caption h2{
    font-size:2.4rem;
    font-weight:700;
}

.carousel-caption p{
    font-size:1.1rem;
}

.wishlist-icon{
    position:absolute;
    top:25px;
    right:25px;
    z-index:100;
}

.wishlist-btn{
    width:55px;
    height:55px;
    border:none;
    border-radius:50%;
    background:white;
    font-size:30px;
    box-shadow:0 10px 25px rgba(0,0,0,.25);
    transition:.3s;
}

.wishlist-btn:hover{
    transform:scale(1.08);
}

.carousel-item::after{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(
        transparent 35%,
        rgba(0,0,0,.55)
    );
}
.booking-card{

    border:1px solid #ececec;

    border-radius:18px;

    padding:25px;

    box-shadow:0 12px 35px rgba(0,0,0,.08);

    top:100px;

    background:white;

}

.feature-box{

    padding:25px;

    border-radius:18px;

    transition:.3s;

}

.feature-box:hover{

    background:#fafafa;

    transform:translateY(-6px);

}

.badge{

    border-radius:50px;

}

.card-body{

    background:white;

}
.review-card{

    transition:.3s;

}

.review-card:hover{

    transform:translateY(-6px);

}

textarea{

    resize:none;

}

.starability-result{

    margin-top:5px;

}

.card{

    transition:.25s;

}

.card:hover{

    box-shadow:0 15px 40px rgba(0,0,0,.08);

}
</style>
<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const coordinates = <%-JSON.stringify(listing.geometry.coordinates) %>;
</script>
<body>
  
    
        <div class="row mt-4">

    <div class="col-lg-8 offset-lg-2">

        <h2 class="mb-3"><%= listing.title %></h2>

      <div class="card border-0 shadow-lg rounded-4 overflow-hidden position-relative">

  <% if(currUser){ %>

    <div class="wishlist-icon">

      <% if(wishlistIds.includes(listing._id.toString())){ %>

      <form action="/wishlist/<%= listing._id %>?_method=DELETE" method="POST">
        <button class="wishlist-btn">
          ❤️
        </button>
      </form>

      <% } else { %>

      <form action="/wishlist/<%= listing._id %>" method="POST">
        <button class="wishlist-btn">
          🤍
        </button>
      </form>

      <% } %>

    </div>

  <% } %>

  <div id="hotelCarousel"
       class="carousel slide carousel-fade"
       data-bs-ride="carousel">

    <div class="carousel-inner">

      <% const gallery = listing.images || []; %>

      <% gallery.forEach((img,index)=>{ %>

      <div class="carousel-item <%= index===0?'active':'' %>">

        <img
        src="<%= img.url %>"
        class="d-block w-100 show-img"
        alt="Hotel">

        <div class="carousel-caption text-start">

          <h2 class="fw-bold">
            <%= listing.title %>
          </h2>

          <p>

            <i class="fa-solid fa-location-dot"></i>

            <%= listing.location %>,
            <%= listing.country %>

          </p>

        </div>

      </div>

      <% }) %>

    </div>

    <% if(gallery.length>1){ %>

    <button
      class="carousel-control-prev"
      data-bs-target="#hotelCarousel"
      data-bs-slide="prev">

      <span class="carousel-control-prev-icon"></span>

    </button>

    <button
      class="carousel-control-next"
      data-bs-target="#hotelCarousel"
      data-bs-slide="next">

      <span class="carousel-control-next-icon"></span>

    </button>

    <% } %>

  </div>

</div>

           <div class="card-body p-5">

<div class="row">

    <!-- LEFT -->

    <div class="col-lg-8">

        <h3 class="fw-bold mb-3">
            <%= listing.title %>
        </h3>

        <p class="text-secondary mb-4">

            <i class="fa-solid fa-user-tie me-2"></i>

            Hosted by

            <b><%= listing.owner.username %></b>

        </p>

        <div class="d-flex flex-wrap gap-3 mb-4">

            <span class="badge bg-light text-dark fs-6 p-3">

                🛏 Entire Place

            </span>

            <span class="badge bg-light text-dark fs-6 p-3">

                ⭐ Super Host

            </span>

            <span class="badge bg-light text-dark fs-6 p-3">

                📍 Prime Location

            </span>

        </div>

        <hr>

        <h4 class="fw-bold mb-3">

            About this property

        </h4>

        <p class="text-muted lh-lg">

            <%= listing.description %>

        </p>

        <hr>

        <div class="row text-center mt-4">

            <div class="col-md-4">

                <div class="feature-box">

                    <i class="fa-solid fa-wifi fa-2x text-danger mb-2"></i>

                    <h6>Free WiFi</h6>

                </div>

            </div>

            <div class="col-md-4">

                <div class="feature-box">

                    <i class="fa-solid fa-square-parking fa-2x text-danger mb-2"></i>

                    <h6>Parking</h6>

                </div>

            </div>

            <div class="col-md-4">

                <div class="feature-box">

                    <i class="fa-solid fa-shield-heart fa-2x text-danger mb-2"></i>

                    <h6>Safe Stay</h6>

                </div>

            </div>

        </div>

    </div>



    <!-- RIGHT -->

    <div class="col-lg-4">

        <div class="booking-card sticky-top">

            <h3 class="fw-bold">

                ₹ <%= listing.price.toLocaleString("en-IN") %>

            </h3>

            <p class="text-muted">

                Per Night

            </p>

            <hr>

            <p>

                <i class="fa-solid fa-location-dot me-2 text-danger"></i>

                <%= listing.location %>

            </p>

            <p>

                <i class="fa-solid fa-earth-asia me-2 text-danger"></i>

                <%= listing.country %>

            </p>

            <% if(currUser){ %>

            <a
            href="/listings/<%= listing._id %>/book"
            class="btn btn-danger w-100 btn-lg rounded-pill">

                Reserve Now

            </a>

            <% } else { %>

            <a
            href="/login"
            class="btn btn-outline-dark w-100 btn-lg rounded-pill">

                Login to Book

            </a>

            <% } %>

        </div>

    </div>

</div>

</div>

        </div>

    </div>

</div>
        <br>
        <% if(currUser && (listing.owner._id.equals(currUser._id) || isAdmin)) { %>
        <div class="btns col-8 offset-2 mb-3 d-flex justify-content-around">
          <!-- Edit Button -->
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark col-2">Edit</a>
        
          <!-- Delete Form -->
          <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" class="col-2 p-0 m-0">
            <button type="submit" class="btn btn-danger w-100">Delete</button>
          </form>
        </div>
        <% } %>

        
       <div class="container mt-5">

<div class="row">

<div class="col-lg-10 mx-auto">

<hr class="mb-5">

<h2 class="fw-bold mb-4">

⭐ Guest Reviews

</h2>


<!-- Review Form -->

<% if(currUser){ %>

<div class="card border-0 shadow-sm rounded-4 mb-5">

<div class="card-body p-4">

<h4 class="mb-4">

Leave your review

</h4>

<form
action="/listings/<%= listing._id %>/reviews"
method="POST"
class="needs-validation"
novalidate>

<div class="mb-4">

<label class="form-label fw-semibold">

Rating

</label>

<fieldset class="starability-grow">

<input type="radio"
id="no-rate"
class="input-no-rate"
name="review[rating]"
value="1"
checked>

<input type="radio" id="r1" name="review[rating]" value="1">

<label for="r1">1</label>

<input type="radio" id="r2" name="review[rating]" value="2">

<label for="r2">2</label>

<input type="radio" id="r3" name="review[rating]" value="3">

<label for="r3">3</label>

<input type="radio" id="r4" name="review[rating]" value="4">

<label for="r4">4</label>

<input type="radio" id="r5" name="review[rating]" value="5">

<label for="r5">5</label>

</fieldset>

</div>

<div class="mb-4">

<label class="form-label fw-semibold">

Your Review

</label>

<textarea
name="review[comment]"
rows="5"
class="form-control rounded-4"
required></textarea>

<div class="invalid-feedback">

Please write your review.

</div>

</div>

<button class="btn btn-danger rounded-pill px-5">

Submit Review

</button>

</form>

</div>

</div>

<% } %>


<!-- Reviews -->

<% if(listing.reviews.length){ %>

<div class="row g-4">

<% listing.reviews.forEach(review=>{ %>

<div class="col-md-6">

<div class="card border-0 shadow-sm rounded-4 h-100">

<div class="card-body p-4">

<div class="d-flex justify-content-between">

<div>

<h5 class="fw-bold mb-1">

<%= review.author.username %>

</h5>

<p
class="starability-result"
data-rating="<%= review.rating %>">

</p>

</div>

<div>

<i class="fa-solid fa-circle-user fa-3x text-secondary"></i>

</div>

</div>

<p class="text-muted mt-3">

<%= review.comment %>

</p>

<% if(currUser && (review.author._id.equals(currUser._id) || isAdmin)){ %>

<form
action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
method="POST">

<button
class="btn btn-sm btn-outline-danger rounded-pill">

Delete

</button>

</form>

<% } %>

</div>

</div>

</div>

<% }) %>

</div>

<% } else { %>

<div class="text-center py-5">

<i class="fa-solid fa-comments fa-4x text-secondary mb-3"></i>

<h4>

No Reviews Yet

</h4>

<p class="text-muted">

Be the first guest to share your experience.

</p>

</div>

<% } %>

</div>

</div>

</div>
        
        <div class="col-8 offset-3 mb-3"> 
          <h3>Where you`ll be</h3>
          <div id="map"></div>
        </div>
      </div>
     
<br><br>
</body>
<script src="/js/map.js"></script>
