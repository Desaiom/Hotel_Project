<% layout("/layouts/boilerplate") %>

<style>
  #filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  .filter {
    text-align: center;
    margin-right: 2rem;
    margin-top: 2rem;
    opacity: 0.7;
  }

  .filter:hover {
    opacity: 1;
    cursor: pointer;
  }

  .filter p {
    font-size: 0.8rem;
  }

  .tax-info {
    display: none;
  }
  .tax-toggle {
    border: 1px solid black;
    border-radius: 1rem;
    height: 3.25rem;
    padding: 1rem;
    margin-left: 2rem;
    display: flex;
    align-items: center;
  }
  .card-hover{
    transition:.25s;
    border:none;
    overflow:hidden;
    border-radius:18px;
}

.card-hover:hover{
    transform:translateY(-5px);
    box-shadow:0 15px 35px rgba(0,0,0,.15);
}

.listing-link{
    text-decoration:none;
    color:inherit;
}

.wishlist-icon{
    position:absolute;
    top:12px;
    right:12px;
    z-index:20;
}

.wishlist-btn{
    background:white;
    border:none;
    border-radius:50%;
    width:42px;
    height:42px;
    font-size:24px;
    cursor:pointer;
    box-shadow:0 4px 12px rgba(0,0,0,.25);
}

.wishlist-btn:hover{
    transform:scale(1.15);
}
</style>

