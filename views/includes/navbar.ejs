<style>
.search-box{
    display:flex;
    align-items:center;
    background:#fff;
    border:1px solid #ddd;
    border-radius:50px;
    padding:6px;
    box-shadow:0 2px 10px rgba(0,0,0,.08);
    transition:.25s;
}.navbar-brand.brand-logo{
    display:flex;
    align-items:center;
    gap:10px;
    font-size:1.7rem;
    font-weight:800;
    text-decoration:none;
    color:#ff385c !important;
    letter-spacing:.5px;
    transition:.3s;
}

.brand-icon{
    font-size:2rem;
    transform:rotate(-20deg);
    transition:.4s;
}
.brand-logo{
    font-size:1.8rem;
    font-weight:900;
    text-decoration:none;
    background:linear-gradient(90deg,#ff385c,#ff7e5f,#ffb347);
    -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;
}

.brand-logo:hover{
    color:#e61e4d !important;
}

.brand-logo:hover .brand-icon{
    transform:rotate(0deg) scale(1.15);
}

.search-box:hover{
    box-shadow:0 5px 20px rgba(0,0,0,.12);
}

.search-input{
    border:none;
    outline:none;
    box-shadow:none !important;
    width:320px;
    padding-left:15px;
    font-size:.95rem;
    background:transparent;
}

.search-input::placeholder{
    color:#888;
}

.search-btn{
    border:none;
    background:#ff385c;
    color:#fff;
    width:42px;
    height:42px;
    border-radius:50%;
    display:flex;
    justify-content:center;
    align-items:center;
    transition:.3s;
}

.search-btn:hover{
    background:#e61e4d;
    transform:scale(1.05);
}

.search-icon{
    color:#777;
    padding-left:12px;
    font-size:15px;
}

@media(max-width:768px){

.search-box{
    width:100%;
}

.search-input{
    width:100%;
}

}
</style>


<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
   <!-- <a class="navbar-brand" href="<%= (currUser && currUser.role === 'host') ? '/host/dashboard' : '/listings' %>">
    <i class="fa-regular fa-compass"></i>
   </a> -->
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">

 <a class="navbar-brand brand-logo" href="<%= (currUser && currUser.role === 'host') ? '/host/dashboard' : '/listings' %>">
    <i class="fa-solid fa-compass brand-icon"></i>
    <span>Wanderlust</span>
</a>

</div>
<% if(!currUser || currUser.role !== "host"){ %>

