<i class="fa-solid fa-magnifying-glass search-icon"></i>

<input
type="search"
name="search"
class="form-control search-input"
placeholder="Search hotels, cities or countries">

<button class="search-btn">

<i class="fa-solid fa-magnifying-glass"></i>

</button>

</form>

</div>

<% } %>
      <div class="navbar-nav ms-auto">
        <% if (canManageListings) { %>
        <a class="nav-link" href="/listings/new">Add new Hotel</a>
        <% } %>
        <% if(!currUser) { %>
        <a class="nav-link" href="/signup"><b>Sign Up</b></a>
        <a class="nav-link" href="/login"><b>Log in</b> </a>
        <% } %> <% if(currUser) { %>
        <div class="nav-item dropdown">
          <a
            class="nav-link dropdown-toggle"
            href="#"
            role="button"
            data-bs-toggle="dropdown"
            aria-expanded="false"
          >
            <i class="fa-solid fa-user-circle me-1"></i><%= currUser.username %>
          </a>
          <ul class="dropdown-menu dropdown-menu-end">

  <li>
    <a class="dropdown-item" href="/profile">
      <i class="fa-solid fa-user me-2"></i>Profile
    </a>
  </li>

  <% if(currUser.role === "user"){ %>

      <li>
        <a class="dropdown-item" href="/bookings">
          <i class="fa-solid fa-calendar-check me-2"></i>My Bookings
        </a>
      </li>

      <li>
        <a class="dropdown-item" href="/wishlist">
          <i class="fa-regular fa-heart me-2"></i>Wishlist
        </a>
      </li>

  <% } %>

  <% if(currUser.role === "host"){ %>

      <li>
        <a class="dropdown-item" href="/host/dashboard">
          <i class="fa-solid fa-chart-line me-2"></i>Host Dashboard
        </a>
      </li>

      <li>
        <a class="dropdown-item" href="/profile/listings">
          <i class="fa-solid fa-house me-2"></i>My Listings
        </a>
