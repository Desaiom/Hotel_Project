<% layout("/layouts/boilerplate") %>

<div class="container mt-4">

<h2 class="mb-4">
My Bookings
</h2>

<% if(bookings.length===0){ %>

<div class="alert alert-info">

No bookings yet.

</div>

<% } %>

<div class="row">

<% bookings.forEach(booking=>{ %>

<div class="col-md-6 mb-4">

<div class="card shadow-sm">

<img
src="<%= listing.images && listing.images.length ? listing.images[0].url : '/images/default.jpg' %>"
class="card-img-top"
style="height:220px;object-fit:cover;">

<div class="card-body">

<h5><%= booking.listing.title %></h5>

<p>

<%= booking.listing.location %>,
<%= booking.listing.country %>

</p>

<p>

Check In :
<b><%= new Date(booking.checkIn).toLocaleDateString() %></b>

</p>

<p>

Check Out :
<b><%= new Date(booking.checkOut).toLocaleDateString() %></b>

</p>

<p>

Guests :
<b><%= booking.guests %></b>

</p>

<p>

Total :
<b>₹ <%= booking.totalPrice %></b>

</p>

<span class="badge bg-success">

<%= booking.paymentStatus %>

</span>

<span class="badge bg-primary">

<%= booking.status %>

</span>

<% if(booking.status==="pending"){ %>

<form
action="/bookings/<%= booking._id %>/cancel?_method=PUT"
method="POST"
class="mt-3">

<button class="btn btn-danger">

Cancel Booking

</button>

</form>

<% } %>

</div>

</div>

</div>

<% }) %>

</div>

</div>